# 复制为 .env 后即可被 docker-compose 自动读取（compose 会用同目录的 .env 做变量替换）。
# Spring Boot 本身不会自动加载 .env，运行应用时请把这些值设置为系统环境变量或写进 IDE 运行配置。
# 切勿把真实生产密码提交到版本库。

# 服务端口
SERVER_PORT=8888

# MySQL（默认值与 docker-compose 内置的开发环境一致；宿主机端口用 3307 以避开本机已装的 MySQL）
MYSQL_URL=jdbc:mysql://localhost:3307/seckill
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_PORT=3307

# Redis（宿主机端口 6380，避开其它项目占用的 6379）
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=123456
REDIS_TIMEOUT=3000

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/
